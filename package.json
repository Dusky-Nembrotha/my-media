{
  "name": "shelved",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A self-hosted, beautiful log of everything you watch, read and listen to.",
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js -n server,client -c cyan,magenta \"node --watch server/index.js\" \"node node_modules/vite/bin/vite.js\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "start": "node server/index.js",
    "serve": "npm run build && node server/index.js",
    "samples": "node scripts/make-samples.js",
    "postinstall": "node -e \"console.log('\\nShelved installed. Run: npm run build && npm start\\n')\""
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^4.21.2",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=22.5"
  }
}