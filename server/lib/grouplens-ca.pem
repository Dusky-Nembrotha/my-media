# The root certificate for files.grouplens.org, pinned deliberately.
#
# GroupLens serve a chain that terminates in "emSign Root TLS CA - G3", which
# is not in any current public trust store — not Debian's, not Mozilla's. Their
# server does not offer an alternative path, so the normal verification cannot
# succeed however up to date your CA bundle is.
#
# The options were to turn certificate checking off for the download, or to
# pin this one root for this one host. Pinning keeps the hostname check and the
# chain check intact: only the trust anchor is supplied by us. Turning checking
# off would have kept neither.
#
# Fetched from the certificate's own Authority Information Access pointer,
# http://repository.emsign.com/certs/EMIncommonOVG3C.p7c, and used solely for
# downloading the public MovieLens datasets.
#
# subject = C=IN, O=eMudhra Technologies Limited, CN=emSign Root TLS CA - G3
subject=C = IN, O = eMudhra Technologies Limited, CN = emSign Root TLS CA - G3
issuer=C = IN, O = eMudhra Technologies Limited, CN = emSign Root TLS CA - G3
